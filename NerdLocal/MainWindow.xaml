<Window x:Class="NerdLocal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NerdLocal - Local Development Manager"
        Width="1360"
        Height="820"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F2F4F7"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- COLORS -->
        <SolidColorBrush x:Key="AccentBrush" Color="#E84444"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#CC3038"/>
        <SolidColorBrush x:Key="PageBrush" Color="#F2F4F7"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#DCE1E8"/>
        <SolidColorBrush x:Key="TextBrush" Color="#202938"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#778195"/>

        <!-- GENERAL TEXT -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- FIELD LABEL -->
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#465166"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- FLAT TEXTBOX -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#202938"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D5DAE2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#E84444"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FLAT BUTTONS -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#354052"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D5DAE2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F0F2F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PRIMARY ACTION -->
        <Style x:Key="RedButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#E84444"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E84444"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#CC3038"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#CC3038"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMPACT DROPDOWN -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D5DAE2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- TABS -->
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="#667085"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                ContentSource="Header"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground"
                                        Value="#E84444"/>
                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="#E84444"/>
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#FFF5F5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#F5F6F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DATA GRID -->
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#354052"/>
            <Setter Property="BorderBrush" Value="#DCE1E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FB"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E9EDF2"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E9EDF2"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#F1F3F6"/>
            <Setter Property="Foreground" Value="#596579"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="BorderBrush" Value="#DCE1E8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#DCE1E8"
                BorderThickness="0,0,0,1"
                Padding="20,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Width="36"
                            Height="36"
                            Background="#E84444"
                            VerticalAlignment="Center">
                        <TextBlock Text="N"
                                   Foreground="#FFFFFF"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="NerdLocal"
                                   FontSize="20"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Local Development Manager"
                                   FontSize="11"
                                   Foreground="#778195"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#FFF5F5"
                        BorderBrush="#F5D4D4"
                        BorderThickness="1"
                        Padding="12,5"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="CONFIGURED DOMAINS"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#A34A4A"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtTotalDomains"
                                       Text="0"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#E84444"/>

                            <TextBlock Text=" domains"
                                       FontSize="11"
                                       Foreground="#778195"
                                       Margin="6,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Border Grid.Row="1"
                Margin="12,10,12,10"
                Background="#FFFFFF"
                BorderBrush="#DCE1E8"
                BorderThickness="1">

            <TabControl Margin="0">

                <!-- DOMAIN MANAGER -->
                <TabItem Header="Domain Manager">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="285"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT FORM -->
                        <Border Grid.Column="0"
                                Background="#FFFFFF"
                                BorderBrush="#DCE1E8"
                                BorderThickness="1"
                                Padding="12">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0"
                                            Margin="0,0,0,14">
                                    <TextBlock x:Name="txtDomainFormTitle"
                                               Text="Add New Domain"
                                               FontSize="17"
                                               FontWeight="Bold"/>

                                    <TextBlock Text="Configure a local website."
                                               FontSize="11"
                                               Foreground="#778195"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1">
                                    <TextBlock Text="DOMAIN NAME"
                                               Style="{StaticResource FieldLabel}"/>

                                    <TextBox x:Name="txtDomain"
                                             ToolTip="Example: myproject.local"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="PROJECT DIRECTORY"
                                               Style="{StaticResource FieldLabel}"/>

                                    <TextBox x:Name="txtPath"
                                             ToolTip="Project web root"/>
                                </StackPanel>

                                <Button Grid.Row="3"
                                        Content="Browse Project Folder"
                                        Click="btnBrowse_Click"
                                        Margin="0,0,0,14"/>

                                <StackPanel Grid.Row="4">
                                    <TextBlock Text="APACHE PORT"
                                               Style="{StaticResource FieldLabel}"/>

                                    <ComboBox x:Name="cmbPort"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="80"/>
                                        <ComboBoxItem Content="8080"/>
                                        <ComboBoxItem Content="8081"/>
                                        <ComboBoxItem Content="8082"/>
                                        <ComboBoxItem Content="3000"/>
                                        <ComboBoxItem Content="5000"/>
                                        <ComboBoxItem Content="9000"/>
                                    </ComboBox>
                                </StackPanel>

                                <Button Grid.Row="5"
                                        x:Name="btnAddDomain"
                                        Content="+   Add Domain"
                                        Style="{StaticResource RedButton}"
                                        Click="btnAddDomain_Click"
                                        Margin="0,0,0,14"/>

                                <Border Grid.Row="6"
                                        Background="#FFF8F0"
                                        BorderBrush="#F0DFC9"
                                        BorderThickness="1"
                                        Padding="9">

                                    <StackPanel>
                                        <TextBlock Text="QUICK NOTES"
                                                   FontWeight="Bold"
                                                   FontSize="10"
                                                   Foreground="#925A20"
                                                   Margin="0,0,0,5"/>

                                        <TextBlock Text="• Use .local or .test domains."
                                                   FontSize="10"
                                                   Foreground="#785D3C"
                                                   Margin="0,2"/>

                                        <TextBlock Text="• Select the correct web root."
                                                   FontSize="10"
                                                   Foreground="#785D3C"
                                                   Margin="0,2"/>

                                        <TextBlock Text="• Run as Administrator."
                                                   FontSize="10"
                                                   Foreground="#785D3C"
                                                   Margin="0,2"/>

                                        <TextBlock Text="• Backups are created before changes."
                                                   FontSize="10"
                                                   Foreground="#785D3C"
                                                   Margin="0,2"/>

                                        <TextBlock Text="• Restart Apache after changes."
                                                   FontSize="10"
                                                   Foreground="#785D3C"
                                                   Margin="0,2"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- RIGHT DOMAIN TABLE -->
                        <Border Grid.Column="2"
                                Background="#FFFFFF"
                                BorderBrush="#DCE1E8"
                                BorderThickness="1"
                                Padding="12">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0"
                                      Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Existing Domains"
                                                   FontSize="17"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="Configured local websites"
                                                   FontSize="11"
                                                   Foreground="#778195"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Background="#EAF6EE"
                                            BorderBrush="#D3EBDD"
                                            BorderThickness="1"
                                            Padding="8,4"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="LOCAL HOSTS"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="#23834F"/>
                                    </Border>
                                </Grid>

                                <TextBox Grid.Row="1"
                                         x:Name="txtSearch"
                                         Height="32"
                                         Margin="0,0,0,10"
                                         ToolTip="Search by domain, path, or port"/>

                                <DataGrid Grid.Row="2"
                                          x:Name="DomainGrid"
                                          IsReadOnly="True"
                                          CanUserSortColumns="True"
                                          CanUserReorderColumns="True"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="DOMAIN"
                                                            Width="180"
                                                            Binding="{Binding Domain}"/>

                                        <DataGridTextColumn Header="PORT"
                                                            Width="70"
                                                            Binding="{Binding Port}"/>

                                        <DataGridTextColumn Header="PROJECT DIRECTORY"
                                                            Width="*"
                                                            MinWidth="160"
                                                            Binding="{Binding Path}"/>

                                        <DataGridTemplateColumn Header="COPY" Width="55">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="⧉"
                                                            Tag="{Binding}"
                                                            ToolTip="Copy domain URL"
                                                            Click="CopyDomain_Click"
                                                            Height="24"
                                                            Padding="5,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="ACTIONS" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Edit"
                                                                Tag="{Binding}"
                                                                Click="EditDomain_Click"
                                                                Height="24"
                                                                Padding="7,0"
                                                                Margin="0,0,5,0"/>
                                                        <Button Content="Delete"
                                                                Tag="{Binding}"
                                                                Click="DeleteDomain_Click"
                                                                Height="24"
                                                                Padding="7,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Grid.Row="3"
                                           Text="Domain changes may require an Apache restart."
                                           FontSize="10"
                                           Foreground="#778195"
                                           Margin="0,9,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- CONFIG FILES -->
                <TabItem Header="Config Files">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="#DCE1E8"
                                BorderThickness="1"
                                Padding="12">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Hosts File"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,10,10"/>

                                <TextBox Grid.Row="0"
                                         Grid.Column="1"
                                         x:Name="txtHostsFile"
                                         Text="C:\Windows\System32\drivers\etc\hosts"/>

                                <TextBlock Grid.Row="1"
                                           Text="VHosts File"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,10,10"/>

                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         x:Name="txtVhostFile"
                                         Text="C:\xampp\apache\conf\extra\httpd-vhosts.conf"/>

                                <TextBlock Grid.Row="2"
                                           Text="HTTPD Config"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0"/>

                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         x:Name="txtHttpdFile"
                                         Text="C:\xampp\apache\conf\httpd.conf"
                                         Margin="0"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1"
                              Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <WrapPanel>
                                <Button Content="Load Hosts"
                                        Click="LoadHosts_Click" Width="93"/>

                                <Button Content="Load VHosts"
                                        Click="LoadVHosts_Click" RenderTransformOrigin="0.5,0.5" Width="93">
                                    <Button.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform Angle="-0.664"/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Button.RenderTransform>
                                </Button>

                                <Button Content="Load HTTPD"
                                        Click="LoadHttpd_Click" Width="98"/>

                                <Button Content="Preview"
                                        Click="PreviewConfig_Click" Width="74"/>
                            </WrapPanel>

                            <Button
                                    Content="Save File"
                                    Style="{StaticResource RedButton}"
                                    Click="SaveConfig_Click"
                                    Margin="1210,0,0,0" Grid.ColumnSpan="2"/>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="#171D29"
                                BorderBrush="#303949"
                                BorderThickness="1"
                                Padding="5">

                            <TextBox x:Name="txtConfigEditor"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Foreground="#E3EAF4"
                                     Background="#171D29"
                                     BorderThickness="0"
                                     Padding="9"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     SpellCheck.IsEnabled="False"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" VerticalAlignment="Top" Height="413"/>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TOOLS -->
                <TabItem Header="Tools">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Configuration Tools"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Margin="0,0,0,4"/>

                                <TextBlock Text="Open your local configuration files."
                                           FontSize="11"
                                           Foreground="#778195"
                                           Margin="0,0,0,12"/>

                                <Border BorderBrush="#DCE1E8"
                                        BorderThickness="1"
                                        Padding="12">

                                    <StackPanel>
                                        <TextBlock Text="Configuration Files"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Margin="0,0,0,10"/>

                                        <Button Content="Open Hosts File"
                                                Click="OpenHostsFile_Click"
                                                Margin="0,0,0,7"/>

                                        <Button Content="Open VHosts File"
                                                Click="OpenVHostsFile_Click"
                                                Margin="0,0,0,7"/>

                                        <Button Content="Open HTTPD Config"
                                                Click="OpenHttpdFile_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="XAMPP Tools"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Margin="0,0,0,4"/>

                                <TextBlock Text="Open the XAMPP control panel."
                                           FontSize="11"
                                           Foreground="#778195"
                                           Margin="0,0,0,12"/>

                                <Border BorderBrush="#DCE1E8"
                                        BorderThickness="1"
                                        Padding="12">

                                    <StackPanel>
                                        <TextBlock Text="XAMPP Control Panel"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Margin="0,0,0,5"/>

                                        <TextBlock Text="Manage Apache and local services."
                                                   FontSize="11"
                                                   Foreground="#778195"
                                                   Margin="0,0,0,12"/>

                                        <Button Content="Open XAMPP Control Panel"
                                                Style="{StaticResource RedButton}"
                                                Click="OpenXampp_Click"
                                                Margin="0,0,0,8"/>

                                        <Button Content="Apache Restart Instructions"
                                                Click="RestartApache_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#FFF8F0"
                                        BorderBrush="#F0DFC9"
                                        BorderThickness="1"
                                        Padding="10"
                                        Margin="0,12,0,0">

                                    <StackPanel>
                                        <TextBlock Text="IMPORTANT"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="#925A20"/>

                                        <TextBlock Text="Validate Apache configuration and check its error log if the service fails to start."
                                                   FontSize="11"
                                                   Foreground="#785D3C"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Border>

        <!-- FOOTER -->
